// firestore.rules
//
// יש להדביק את הכללים האלה בקונסולת Firebase:
// Firestore Database → Rules → (החלף את כל התוכן) → Publish
//
// 1. sites/... — תזכורות בענן (כמו קודם): כל בקשה חייבת להיות "מחוברת" (אנונימית או Google).
// 2. users/{uid}/... — הגיבוי המלא של הנתונים: רק בעל החשבון (מחובר ב-Google, לא אנונימי)
//    יכול לקרוא/לכתוב את הגיבויים של עצמו. אף אחד אחר לא יכול לראות אותם.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sites/{siteId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
